# Port the API listens on. Falls back to 3000 when unset.
PORT=3000

# MongoDB connection string (for example, a MongoDB Atlas cluster).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Secret used to sign and verify JWTs. Use a long, random value.
JWT_SECRET=replace-with-a-long-random-secret

# JWT lifetime, for example 1d, 12h or 30m. Falls back to 1d when unset.
JWT_EXPIRES_IN=1d

# Supabase project URL.
SUPABASE_URL=https://tsyhrnxfaclimachulwb.supabase.co

# Supabase service role key. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key